<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Lenden.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Lenden.Web.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
</head>
<body>
<div class="d-flex">
<!-- Sidebar -->
<aside class="bg-dark text-white p-3 vh-100 d-flex flex-column justify-content-between" style="width: 250px;">

    <!-- Top Section: Brand + Navigation -->
    <div>
        <h4 class="mb-4">Lenden</h4>

        <ul class="nav nav-pills flex-column gap-2">

            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Home" asp-action="Dashboard">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="User" asp-action="Index">
                    <i class="bi bi-people me-2"></i> Users
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Group" asp-action="Index">
                    <i class="bi bi-diagram-3 me-2"></i> Groups
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Expense" asp-action="Index">
                    <i class="bi bi-cash-stack me-2"></i> Expenses
                </a>
            </li>

            <hr class="text-secondary"/>

            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Admin" asp-action="Settings">
                    <i class="bi bi-gear me-2"></i> Settings
                </a>
            </li>

        </ul>
    </div>

    <!-- Bottom Section: Profile + Logout -->
    <div>
        <div class="d-flex align-items-center gap-2 mb-2">
            <img src="https://i.pravatar.cc/40" alt="Avatar" class="rounded-circle" width="40" height="40" />
            <span class="fw-semibold">Admin</span>
        </div>

        <ul class="nav flex-column gap-1">
            <li class="nav-item">
                <a class="nav-link text-white" asp-controller="Account" asp-action="Profile">
                    <i class="bi bi-person me-2"></i> Profile
                </a>
            </li>

            <li class="nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-danger w-100 d-flex align-items-center justify-content-start">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </button>
                </form>
            </li>
        </ul>
    </div>

</aside>
